generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  password      String
  aiApiKey      String?   // 用户自定义 DeepSeek/OpenAI API Key
  industryContext String? @db.Text // 业务场景描述，用于 AI 意向分析
  intentScoreThreshold Int @default(4) // 高意向阈值，1-5
  noiseRules    Json?     // 用户自定义噪音规则
  plan          Plan      @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联
  videos        Video[]
  replyTemplates ReplyTemplate[]
  dmTemplates   DmTemplate[]
  activities    Activity[]
  aiResearchHistory AiResearchHistory[]
  platformCredentials PlatformCredential[]
  keywordMonitors KeywordMonitor[]
  senderAccounts SenderAccount[]

  @@map("users")
}

model PlatformCredential {
  id        String   @id @default(cuid())
  userId    String
  platform  Platform
  cookies   String   @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("platform_credentials")
}

model Video {
  id                  String    @id @default(cuid())
  url                 String
  platform            Platform  @default(DOUYIN)
  title               String?
  author              String?
  status              VideoStatus @default(MONITORING)
  lastScrapedAt       DateTime?
  consecutiveFailures Int       @default(0)
  userId              String
  keywordMonitorId    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  comments       Comment[]
  keywordMonitor KeywordMonitor? @relation(fields: [keywordMonitorId], references: [id], onDelete: SetNull)

  @@index([keywordMonitorId])
  @@map("videos")
}

model Comment {
  id          String    @id @default(cuid())
  content     String
  authorName  String
  authorAvatar String?
  intentScore Int       @default(0) // 1-5
  intentKeywords String[]
  matchedKeywords String[]
  isNoise     Boolean   @default(false)
  noiseType   String?   // peer | vendor | scam | offtopic | emotional | none
  noiseReason String?   @db.Text
  status      CommentStatus @default(NEW)
  videoId     String
  createdAt   DateTime  @default(now())
  
  video       Video     @relation(fields: [videoId], references: [id])
  replies     Reply[]
  dms         Dm[]
  
  @@index([videoId, isNoise])
  @@map("comments")
}

model Reply {
  id          String    @id @default(cuid())
  content     String
  status      ReplyStatus @default(PENDING)
  sentAt      DateTime?
  commentId   String
  createdAt   DateTime  @default(now())
  
  comment     Comment   @relation(fields: [commentId], references: [id])
  
  @@map("replies")
}

model Dm {
  id          String    @id @default(cuid())
  content     String
  status      DmStatus  @default(PENDING)
  sentAt      DateTime?
  commentId   String
  createdAt   DateTime  @default(now())
  
  comment     Comment   @relation(fields: [commentId], references: [id])
  
  @@map("dms")
}

model ReplyTemplate {
  id          String    @id @default(cuid())
  name        String
  content     String
  isDefault   Boolean   @default(false)
  userId      String
  createdAt   DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id])
  
  @@map("reply_templates")
}

model DmTemplate {
  id          String    @id @default(cuid())
  name        String
  content     String
  isDefault   Boolean   @default(false)
  userId      String
  createdAt   DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id])
  
  @@map("dm_templates")
}

model Activity {
  id          String    @id @default(cuid())
  type        ActivityType
  description String
  metadata    Json?
  userId      String
  createdAt   DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id])
  
  @@map("activities")
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum Platform {
  DOUYIN
  KUAISHOU
  SHIPINHAO
}

enum VideoStatus {
  MONITORING
  PAUSED
  COMPLETED
  ERROR
}

enum CommentStatus {
  NEW
  ANALYZED
  REPLIED
  DM_SENT
  CONVERTED
}

enum ReplyStatus {
  PENDING
  SENT
  FAILED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
}

enum ActivityType {
  VIDEO_ADDED
  COMMENTS_SCRAPED
  INTENT_ANALYZED
  REPLY_SENT
  DM_SENT
  USER_CONVERTED
  ERROR
}

model AiResearchHistory {
  id                    String    @id @default(cuid())
  userId                String
  title                 String?
  industry              String?
  url                   String?
  combinedSearchQueries String[]
  coreKeywords          String[]
  longTailKeywords      String[]
  painPoints            String[]
  competitorAccounts    String[]
  searchCommands        Json?
  scoredKeywords        Json?     // 含搜索量/竞争度/商业意向评分的关键词
  indexData             Json?     // 原始指数 API 响应数据
  usedRealIndexData     Boolean   @default(false) // 是否使用了真实指数数据
  researchSummary       String?   @db.Text
  researchHotTopics     String[]
  researchPainPoints    String[]
  researchCompetitors   String[]
  researchKeywords      String[]
  tags                  String[]  @default([])
  isFavorite            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isFavorite])
  @@map("ai_research_history")
}

model KeywordMonitor {
  id        String   @id @default(cuid())
  userId    String
  keyword   String
  source    String?  // 来源研究记录 ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos    Video[]

  @@unique([userId, keyword])
  @@index([userId, updatedAt])
  @@map("keyword_monitors")
}

model SenderAccount {
  id            String        @id @default(cuid())
  userId        String
  platform      Platform      @default(DOUYIN)
  label         String        // 账号备注，如"主号""小号1"
  cookies       String        @db.Text // 加密存储
  proxyUrl      String?
  status        AccountStatus @default(ACTIVE)
  healthScore   Int           @default(100) // 0-100
  failCount     Int           @default(0)   // 连续失败次数
  lastFailAt    DateTime?
  lastSuccessAt DateTime?
  dailySent     Int           @default(0)   // 当日已发送
  dailyLimit    Int           @default(50)  // 账号日限额
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, status])
  @@map("sender_accounts")
}

enum AccountStatus {
  ACTIVE
  COOLING
  DISABLED
  EXPIRED
}
